{
  "_aciklama": "Referanslı kayıtlardaki hesaplar arası giden virmanların bölge bazında toplu Netsis aktarımı.",
  "id": "netsis_virman_toplu",
  "name": "Netsis — Hesaplar Arası Virman Toplu",
  "description": "Negatif Referanslı hareketlerden hedef şirket hesabı kesin bulunan virmanları her bölge için tek XLSX dosyasında toplar.",
  "category": "referansli",
  "protected": true,
  "grouping": "region",
  "output_extension": "xlsx",
  "template_file": "netsis_virman_toplu_template.xlsx",
  "columns": [
    {"header": "Banka Hes.Kodu(*)", "width": 18, "style": "text", "source": "field", "field": "kaynak_banka_hesap_kodu"},
    {"header": "Gelen/Gönderilen (0/1)", "width": 18, "style": "integer", "source": "const", "value": 1},
    {"header": "Referans No", "width": 14, "style": "text", "source": "const", "value": null},
    {"header": "İşlem Tarihi(*)", "width": 15, "style": "text", "source": "field", "field": "islem_tarihi_metni"},
    {"header": "Efektif Tarih(*)", "width": 15, "style": "text", "source": "field", "field": "islem_tarihi_metni"},
    {"header": "Dekont No", "width": 12, "style": "text", "source": "const", "value": null},
    {"header": "Cari R.K.", "width": 11, "style": "text", "source": "const", "value": null},
    {"header": "Banka Hesap Kodu(*)", "width": 18, "style": "text", "source": "field", "field": "hedef_banka_hesap_kodu"},
    {"header": "TCMB Ana Kod", "width": 12, "style": "text", "source": "const", "value": null},
    {"header": "TCMB Şube Kod", "width": 13, "style": "text", "source": "const", "value": null},
    {"header": "Banka Hes.No", "width": 14, "style": "text", "source": "const", "value": null},
    {"header": "IBAN", "width": 16, "style": "text", "source": "const", "value": null},
    {"header": "Döviz Tipi(*)", "width": 12, "style": "integer", "source": "const", "value": 0},
    {"header": "Döviz Tutar", "width": 13, "style": "text", "source": "const", "value": null},
    {"header": "Tutar", "width": 15, "style": "amount", "source": "field", "field": "tutar"},
    {"header": "Açıklama", "width": 45, "style": "text", "source": "field", "field": "aciklama"},
    {"header": "Cari Açıklama", "width": 40, "style": "text", "source": "const", "value": null},
    {"header": "Yevmiye Açıklama", "width": 50, "style": "text", "source": "const", "value": null},
    {"header": "Muh.Ref.Kod(*)", "width": 14, "style": "text", "source": "field", "field": "muh_ref_kodu"},
    {"header": "Proje Kodu(*)", "width": 13, "style": "integer", "source": "field", "field": "proje_kodu"},
    {"header": "Plas.Kodu", "width": 11, "style": "text", "source": "field", "field": "plasiyer_kodu", "force_text": true},
    {"header": "İşlem Masrafı Banka Hesap Kodu", "width": 20, "style": "text", "source": "const", "value": null},
    {"header": "İşlem Masrafı Muhasebe Kodu", "width": 20, "style": "text", "source": "const", "value": null},
    {"header": "İşlem Masrafı Muh.Ref.Kod", "width": 18, "style": "text", "source": "const", "value": null},
    {"header": "İşlem Masrafı Proje Kodu", "width": 18, "style": "text", "source": "const", "value": null},
    {"header": "İşlem Masrafı Döviz Tutar", "width": 18, "style": "text", "source": "const", "value": null},
    {"header": "İşlem Masrafı Tutar", "width": 16, "style": "text", "source": "const", "value": null},
    {"header": "BSMV Muhasebe Kodu", "width": 18, "style": "text", "source": "const", "value": null},
    {"header": "BSMV Muh.Ref.Kod", "width": 16, "style": "text", "source": "const", "value": null},
    {"header": "BSMV Proje Kodu", "width": 16, "style": "text", "source": "const", "value": null},
    {"header": "BSMV Döviz Tutar", "width": 16, "style": "text", "source": "const", "value": null},
    {"header": "BSMV Tutar", "width": 14, "style": "text", "source": "const", "value": null}
  ]
}
