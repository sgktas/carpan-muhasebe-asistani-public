# PostgreSQL bağlantısı yalnız Çarpan'a ayrılmış veritabanını göstermelidir.
CARPAN_DATABASE_URL=postgresql://carpan_app:CHANGE_ME@127.0.0.1:5432/carpan_platform

# Üretimde 32+ bayt rastgele, gizli bir değer kullanın. Bu örnek değerle çalışmayın.
CARPAN_JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
CARPAN_JWT_ISSUER=carpan-platform
CARPAN_ENVIRONMENT=development
CARPAN_ALLOWED_ORIGINS=http://127.0.0.1:3000
