server {
    listen 80;
    server_name api.REPLACE_WITH_DOMAIN;

    # Alan adı ve sertifika hazır olana kadar bu blok yalnız taslaktır.
    # Canlı kullanımda HTTP isteği HTTPS'e yönlendirilmelidir.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name api.REPLACE_WITH_DOMAIN;

    ssl_certificate /etc/letsencrypt/live/api.REPLACE_WITH_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.REPLACE_WITH_DOMAIN/privkey.pem;

    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
