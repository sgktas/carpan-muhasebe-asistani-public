[Unit]
Description=Çarpan Merkezi Platform API
After=network.target postgresql.service

[Service]
Type=simple
User=carpan
Group=carpan
WorkingDirectory=/var/www/carpan-platform/current/platform_api
EnvironmentFile=/etc/carpan-platform/api.env
ExecStart=/var/www/carpan-platform/venv/bin/uvicorn carpan_platform.main:app --host 127.0.0.1 --port 8010 --workers 2
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/carpan-platform

[Install]
WantedBy=multi-user.target
